{
  "name": "@linagora/twake-mui",
  "type": "module",
  "version": "10.5.1",
  "description": "MUI v9 theme system for Twake applications",
  "author": "Twake",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/twake-ui.git",
    "directory": "packages/twake-mui"
  },
  "keywords": [
    "twake",
    "mui",
    "theme",
    "material-ui",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:doc": "storybook build --output-dir storybook-static",
    "start": "tsc --watch",
    "test": "vitest run --project unit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist",
    "doc": "storybook dev -p 6006",
    "screenshots": "vitest run"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@linagora/twake-icons": ">=2.10.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.2.0",
    "cozy-intent": ">=2.29.1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "twake-i18n": ">=0.6.0"
  },
  "dependencies": {
    "@linagora/twake-css": "^1.0.0",
    "@mui/utils": "^9.2.0",
    "@react-spring/web": "10.1.2",
    "@use-gesture/react": "10.3.1",
    "classnames": "^2.5.1",
    "react-use-measure": "2.1.7",
    "react-virtuoso": "4.13.0",
    "rooks": "8.4.0"
  },
  "devDependencies": {
    "@argos-ci/cli": "6.9.5",
    "@argos-ci/storybook": "6.4.1",
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@linagora/twake-icons": "^2.10.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.2.0",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/builder-vite": "10.3.5",
    "@storybook/react": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/classnames": "^2.3.1",
    "@types/lodash": "4.17.24",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "cozy-intent": "^2.31.1",
    "cozy-tsconfig": "^2.0.0",
    "eslint": "10.2.1",
    "eslint-config-cozy-app": "7.0.0",
    "eslint-plugin-storybook": "10.3.5",
    "jsdom": "^30.1.2",
    "lodash": "4.18.1",
    "playwright": "1.60.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.3.5",
    "twake-i18n": "^0.6.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
