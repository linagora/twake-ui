{
  "extends": "cozy-tsconfig",
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-utils.ts"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "emitDeclarationOnly": false,
    "module": "nodenext",
    "moduleResolution": "nodenext"
  }
}
